# Maintainer: iNeXcf
pkgname=fastpotify-plus-git
pkgver=0.5.0.r387.5fcf515
pkgrel=2
pkgdesc="Fastpotify+ native Spotify client with direct type-ahead navigation"
arch=('x86_64' 'aarch64')
url="https://github.com/iNeXcf/fastpotify"
license=('MIT')
depends=('alsa-lib' 'libpulse' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11'
         'hicolor-icon-theme')
makedepends=('git' 'cargo' 'cmake' 'clang')
optdepends=('libxkbcommon-x11: keyboard handling in X11 sessions'
            'pipewire-pulse: PipeWire as the PulseAudio server')
provides=('fastpotify')
conflicts=('fastpotify' 'fastpotify-bin' 'fastpotify-git')
# ring compiles its own C. Arch's LTO flags produce objects its linker cannot
# resolve, while Cargo already applies the project's release profile.
options=('!debug' '!lto')
source=('fastpotify-plus::git+https://github.com/iNeXcf/fastpotify.git#branch=feature/typeahead-song-lists')
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/fastpotify-plus"
  version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml)
  version=${version/-/}
  printf '%s.r%s.%s' "$version" "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "${srcdir}/fastpotify-plus"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/fastpotify-plus"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/"
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/fastpotify-plus"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --features demo
}

package() {
  cd "${srcdir}/fastpotify-plus"

  install -Dm755 "target/release/fastpotify" "${pkgdir}/usr/bin/fastpotify"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "packaging/applications/fastpotify.desktop" \
    "${pkgdir}/usr/share/applications/fastpotify.desktop"
  install -Dm644 "packaging/icons/fastpotify.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/fastpotify.svg"
}
