# Maintainer: iNeXcf
pkgname=spotifast-plus-git
pkgver=0.12.0.r829.d3c81da
pkgrel=1
pkgdesc="Spotifast+ native Spotify client with direct type-ahead navigation"
arch=('x86_64' 'aarch64')
url="https://github.com/iNeXcf/spotifast"
license=('MIT')
depends=('dbus' 'alsa-lib' 'libpulse' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11'
         'hicolor-icon-theme')
makedepends=('git' 'cargo' 'cmake' 'clang')
optdepends=('libxkbcommon-x11: keyboard handling in X11 sessions'
            'pipewire-pulse: PipeWire as the PulseAudio server')
provides=('spotifast')
conflicts=('spotifast' 'spotifast-bin' 'spotifast-git'
           'fastpotify' 'fastpotify-bin' 'fastpotify-git')
# ring compiles its own C. Arch's LTO flags produce objects its linker cannot
# resolve, while Cargo already applies the project's release profile.
options=('!debug' '!lto')
source=('spotifast-plus::git+https://github.com/iNeXcf/spotifast.git#branch=spotifast-plus')
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/spotifast-plus"
  version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml)
  version=${version/-/}
  printf '%s.r%s.%s' "$version" "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "${srcdir}/spotifast-plus"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/spotifast-plus"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/"
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/spotifast-plus"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --features demo
}

package() {
  cd "${srcdir}/spotifast-plus"

  install -Dm755 "target/release/spotifast" "${pkgdir}/usr/bin/spotifast"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "packaging/applications/spotifast.desktop" \
    "${pkgdir}/usr/share/applications/spotifast.desktop"
  install -Dm644 "packaging/icons/spotifast.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/spotifast.svg"
}
